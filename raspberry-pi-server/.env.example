# ============================================================================
# 1. Server Port Configuration
# ============================================================================
PORT=3000

# ============================================================================
# 2. Hardware & Simulation Configuration (Raspberry Pi 4)
# ============================================================================
# Set to "true" to force simulated sensor readings (auto-enabled on non-Linux OS)
# Set to "false" on Raspberry Pi 4 when real sensors are connected
SIMULATE_HARDWARE=false

# SHT31 I2C Configuration (Pin 3 = SDA / GPIO 2, Pin 5 = SCL / GPIO 3)
I2C_BUS_NUMBER=1
SHT31_I2C_ADDRESS=0x44

# LED GPIO Configuration (BCM Pin Numbers)
# Physical Pin 11 = GPIO 17
LED_GPIO_PIN=17

# Ultrasonic HC-SR04 GPIO Configuration (BCM Pin Numbers)
# Physical Pin 16 = GPIO 23 (TRIG), Physical Pin 18 = GPIO 24 (ECHO via Voltage Divider)
ULTRASONIC_TRIG_PIN=23
ULTRASONIC_ECHO_PIN=24

# Sensor polling interval in milliseconds (default: 5000 ms = 5 seconds)
SENSOR_POLL_INTERVAL_MS=5000

# ============================================================================
# 3. MQTT Broker Configuration (lora.kmitl.ac.th or HiveMQ / EMQX / Mosquitto)
# ============================================================================
MQTT_BROKER_URL=mqtt://lora.kmitl.ac.th:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=rpi4-mcp-iot-server

# ============================================================================
# 4. ChirpStack LoRaWAN Configuration (https://lora.kmitl.ac.th/)
# ============================================================================
# Replace with your Application ID and Arduino R4 Device EUI from ChirpStack
CHIRPSTACK_APP_ID=your-application-id
CHIRPSTACK_DEV_EUI=0000000000000000
CHIRPSTACK_DOWNLINK_FPORT=1

